# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=tu_token_de_bot_de_telegram
TELEGRAM_CHANNEL_ID=tu_canal_donde_alertar
# ID de Telegram del dueño (único con acceso a comandos de administración)
AUTHORIZED_USER_ID=tu_id_de_telegram

# === OPENSKY NETWORK (opcional, recomendado) ===
OPENSKY_CLIENT_ID=tu_client_id_de_opensky
OPENSKY_CLIENT_SECRET=tu_client_secret_de_opensky

# === TWITTER / X (opcional) ===
TWITTER_ENABLED=0
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# === BASE DE DATOS ===
# SQLite local por defecto
DB_PATH=aerobot.db
# Para PostgreSQL: DATABASE_URL=postgresql://user:pass@host:5432/dbname
